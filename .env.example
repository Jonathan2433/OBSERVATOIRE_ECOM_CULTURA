# =============================================================================
#  Observatoire Ecom Studio — variables d'environnement
#  Copier en `.env` et renseigner les secrets :  cp .env.example .env
#  NE JAMAIS committer le fichier .env (il est ignoré par git).
# =============================================================================

# --- Base de données PostgreSQL (locale) ------------------------------------
# IMPORTANT : POSTGRES_PASSWORD n'est appliqué qu'à la PREMIÈRE création du
# volume de données. Si vous le modifiez ensuite, l'API ne pourra plus se
# connecter ; il faut alors réinitialiser le volume : `docker compose down -v`
# (ceci EFFACE la base). Fixez ce mot de passe une fois pour toutes.
POSTGRES_USER=oes
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=oes

# --- Sécurité applicative ----------------------------------------------------
# Clé de signature des sessions/JWT. Générer une valeur aléatoire forte, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-strong-random-key

# --- Compte administrateur initial (créé au 1er démarrage si la base est vide) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-min-12-chars

# --- Divers ------------------------------------------------------------------
APP_ENV=production
WEB_PORT=8080            # http://localhost:8080
WORKER_THREADS=4         # threads CPU alloués à l'inférence (OMP)
